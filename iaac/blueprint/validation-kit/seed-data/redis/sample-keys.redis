# Redis Sample Data
# K3D Blueprint Validation Kit

# String operations
SET user:1000:name "John Doe"
SET user:1000:email "john@example.com"
SET user:1001:name "Jane Smith"
SET user:1001:email "jane@example.com"

# Counters
SET stats:page_views 0
INCR stats:page_views
INCR stats:page_views
SET stats:active_users 42

# Key with expiration (30 minutes)
SETEX session:abc123 1800 "user_id:1000"

# Hash operations
HSET user:1000 username "john_doe" email "john@example.com" created_at "2024-01-01"
HSET user:1001 username "jane_smith" email "jane@example.com" created_at "2024-01-02"

# List operations - Recent activities
LPUSH recent_activities "User john_doe logged in"
LPUSH recent_activities "User jane_smith updated profile"
LPUSH recent_activities "User john_doe viewed dashboard"
LTRIM recent_activities 0 99

# Set operations - User roles
SADD user:1000:roles "user" "editor"
SADD user:1001:roles "user" "admin" "editor"

# Sorted set - Leaderboard
ZADD leaderboard 100 "john_doe"
ZADD leaderboard 150 "jane_smith"
ZADD leaderboard 75 "bob_wilson"
ZADD leaderboard 200 "alice_johnson"

# Cache simulation
SET cache:api:users "[{\"id\":1000,\"name\":\"John Doe\"},{\"id\":1001,\"name\":\"Jane Smith\"}]"
EXPIRE cache:api:users 300

# Rate limiting buckets
SET rate_limit:api:192.168.1.100 10
EXPIRE rate_limit:api:192.168.1.100 60

# Pub/Sub channels (for reference)
# PUBLISH notifications "New user registered"
# PUBLISH updates "System maintenance scheduled"

# Geospatial data
GEOADD locations 13.361389 38.115556 "Palermo"
GEOADD locations 15.087269 37.502669 "Catania"
GEOADD locations -122.419416 37.774929 "San Francisco"
GEOADD locations -74.005974 40.712776 "New York"

# Bitmap for user activity tracking
SETBIT user_activity:2024:01:01 1000 1
SETBIT user_activity:2024:01:01 1001 1
SETBIT user_activity:2024:01:02 1000 0
SETBIT user_activity:2024:01:02 1001 1

# HyperLogLog for unique visitor counting
PFADD unique_visitors:2024:01 "192.168.1.100" "192.168.1.101" "192.168.1.102"
PFADD unique_visitors:2024:01 "192.168.1.103" "192.168.1.100"

# Stream for event logging
XADD events:stream * user "john_doe" action "login" ip "192.168.1.100"
XADD events:stream * user "jane_smith" action "purchase" amount "99.99"

# JSON operations (if RedisJSON module is available)
# JSON.SET user:1000:profile $ '{"name":"John Doe","age":30,"interests":["coding","gaming"]}'