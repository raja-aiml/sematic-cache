{
  "sample_metrics": [
    {
      "metric_name": "semantic_cache_hits_total",
      "type": "counter",
      "help": "Total number of cache hits",
      "labels": {
        "service": "semantic-cache",
        "namespace": "default"
      },
      "value": 1234
    },
    {
      "metric_name": "semantic_cache_misses_total",
      "type": "counter",
      "help": "Total number of cache misses",
      "labels": {
        "service": "semantic-cache",
        "namespace": "default"
      },
      "value": 567
    },
    {
      "metric_name": "semantic_cache_latency_seconds",
      "type": "histogram",
      "help": "Cache operation latency in seconds",
      "labels": {
        "operation": "get",
        "service": "semantic-cache"
      },
      "buckets": [0.001, 0.01, 0.1, 0.5, 1.0, 5.0],
      "sum": 123.45,
      "count": 1801
    },
    {
      "metric_name": "postgres_connections_active",
      "type": "gauge",
      "help": "Number of active PostgreSQL connections",
      "labels": {
        "database": "semantic_cache",
        "service": "postgres"
      },
      "value": 15
    },
    {
      "metric_name": "redis_memory_used_bytes",
      "type": "gauge",
      "help": "Redis memory usage in bytes",
      "labels": {
        "service": "redis",
        "instance": "redis:6379"
      },
      "value": 52428800
    }
  ],
  "sample_queries": [
    {
      "description": "Cache hit rate",
      "query": "rate(semantic_cache_hits_total[5m]) / (rate(semantic_cache_hits_total[5m]) + rate(semantic_cache_misses_total[5m]))"
    },
    {
      "description": "Average latency by operation",
      "query": "histogram_quantile(0.95, rate(semantic_cache_latency_seconds_bucket[5m]))"
    },
    {
      "description": "PostgreSQL connection saturation",
      "query": "postgres_connections_active / postgres_connections_max"
    },
    {
      "description": "Redis memory usage percentage",
      "query": "redis_memory_used_bytes / redis_memory_max_bytes * 100"
    }
  ]
}