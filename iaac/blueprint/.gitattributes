# Git attributes for K3D Blueprint

# Ensure consistent line endings
* text=auto
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sql text eol=lf

# Mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.tar binary
*.gz binary
*.zip binary

# Diff settings
*.md diff=markdown
*.yaml diff=yaml
*.json diff=json

# Export ignore (files to exclude from archives)
.gitignore export-ignore
.gitattributes export-ignore
.env.example export-ignore
/validation-kit export-ignore
/hack export-ignore