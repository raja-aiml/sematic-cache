# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts
*.sh text eol=lf

# YAML files
*.yaml text eol=lf
*.yml text eol=lf

# JSON files
*.json text eol=lf

# Markdown files
*.md text eol=lf

# Dockerfile
Dockerfile text eol=lf

# Go files
*.go text eol=lf

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.svg binary