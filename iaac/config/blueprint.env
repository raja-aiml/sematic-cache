# Blueprint Configuration
# Copy this file to .env and customize for your environment

# Cluster Configuration
CLUSTER_NAME=blueprint
K3D_REGISTRY_NAME=blueprint-registry
K3D_REGISTRY_PORT=5000

# Network Configuration
CLUSTER_API_PORT=6443
CLUSTER_HTTP_PORT=8080
CLUSTER_HTTPS_PORT=8443

# Application Configuration
APP_IMAGE=sematic-cache:latest
APP_PORT=8080
APP_REPLICAS=1

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sematic_cache
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# Monitoring Configuration
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Logging Configuration
LOKI_RETENTION_PERIOD=168h

# Tracing Configuration
TEMPO_RETENTION_PERIOD=24h
OTEL_COLLECTOR_ENDPOINT=http://otel-collector:4317

# Security Configuration
ENABLE_NETWORK_POLICIES=true
ENABLE_POD_SECURITY=true
ENABLE_MTLS=true

# Development Configuration
DEBUG_MODE=false
LOG_LEVEL=info
METRICS_ENABLED=true