# Secrets Configuration Template
# Copy this file to .env and fill in your actual secret values
# NEVER commit .env file to version control

# OpenAI API Key (Required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Database Connection (default for local development)
DATABASE_URL=your-database-connection-string-here

# Telemetry Endpoint (empty by default, can be overridden)
OTEL_EXPORTER_OTLP_ENDPOINT=your-telemetry-endpoint-here